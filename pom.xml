<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>br.com.escola</groupId>
    <artifactId>school-management-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>school-management-platform</name>

    <modules>
        <module>school-management-bff</module>
        <module>identity-access-service</module>
        <module>institutional-tenant-service</module>
        <module>dashboard-query-service</module>
        <module>academic-catalog-service</module>
        <module>academic-professor-service</module>
        <module>people-service</module>
        <module>responsibles-service</module>
        <module>enrollment-document-service</module>
        <module>pedagogical-service</module>
        <module>planning-ai-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <archunit.version>1.4.1</archunit.version>
        <mockwebserver.version>4.12.0</mockwebserver.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <testcontainers.version>1.21.3</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.4</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.6.2</version>
                    <executions>
                        <execution>
                            <id>enforce-platform</id>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <requireJavaVersion>
                                        <version>[21,22)</version>
                                    </requireJavaVersion>
                                    <requireMavenVersion>
                                        <version>[3.9,)</version>
                                    </requireMavenVersion>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-service-class-naming</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target name="enforce-service-class-naming">
                                <path id="forbidden.service.class.naming.files">
                                    <fileset dir="${project.basedir}">
                                        <include name="school-management-bff/src/**/*.java"/>
                                        <include name="identity-access-service/src/**/*.java"/>
                                        <include name="institutional-tenant-service/src/**/*.java"/>
                                        <include name="dashboard-query-service/src/**/*.java"/>
                                        <include name="academic-catalog-service/src/**/*.java"/>
                                        <include name="academic-professor-service/src/**/*.java"/>
                                        <include name="people-service/src/**/*.java"/>
                                        <include name="responsibles-service/src/**/*.java"/>
                                        <include name="enrollment-document-service/src/**/*.java"/>
                                        <include name="pedagogical-service/src/**/*.java"/>
                                        <include name="planning-ai-service/src/**/*.java"/>
                                        <filename regex=".*(People|Responsibles|PlanningAi|Dashboard|AcademicCatalog|IdentityAccess|InstitutionalTenant|EnrollmentDocument|Pedagogical|Monolith|ProfessorShadow).*\.java$"/>
                                    </fileset>
                                </path>

                                <resourcecount property="forbidden.service.class.naming.count"
                                               refid="forbidden.service.class.naming.files"/>
                                <pathconvert property="forbidden.service.class.naming.list"
                                             pathsep="${line.separator}"
                                             refid="forbidden.service.class.naming.files"/>
                                <condition property="forbidden.service.class.naming.detected">
                                    <not>
                                        <equals arg1="${forbidden.service.class.naming.count}" arg2="0"/>
                                    </not>
                                </condition>

                                <fail if="forbidden.service.class.naming.detected"
                                      message="Forbidden cross-service class naming detected in modular services:${line.separator}${forbidden.service.class.naming.list}"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.4</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
